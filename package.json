    "test": "vitest run",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "qr": "node scripts/make-qr.mjs",
    "build:models": "node scripts/build-models.mjs",
    "build:plates": "node scripts/render-plates.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@somakine/bodyparts3d-musculoskeletal": "^0.2.0",
    "@tailwindcss/vite": "^4.3.5",
