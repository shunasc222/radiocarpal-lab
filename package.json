{
  "name": "radiocarpal-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RADIOCARPAL LAB — laboratorio virtual de anatomía, biomecánica y correlación clínica de la muñeca (PUCE Santo Domingo).",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
