    "d3-contour": "^4.0.3",
    "jsdom": "^31.0.1",
    "jsqr": "^1.4.0",
    "meshoptimizer": "^1.3.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "three-subdivide": "^1.1.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
